# Copy to .env in a private deployment environment and replace every placeholder.
# Never commit .env or paste real secret values into issue trackers.
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://0.0.0.0:8080

# Production SQL Server; provision the database and apply the documented schema scripts first.
ConnectionStrings__MpsDatabase=Server=<sql-server>;Database=MPS;User ID=<db-user>;Password=<db-password>;Encrypt=True;TrustServerCertificate=False

# Each key must be Base64 for at least 32 random bytes and remain stable across restarts.
MPS_JWT_SIGNING_KEY=<base64-32-random-bytes>
MPS_PHONE_ENCRYPTION_KEY=<base64-32-random-bytes>

# Required only when using protected platform operations such as /platform.
MPS_PLATFORM_PROVISIONING_KEY=<base64-32-random-bytes>

# Required for registration OTP and student expiry reminders.
Email__SmtpHost=<smtp-host>
Email__SmtpPort=587
Email__SmtpUsername=<smtp-username>
Email__SmtpPassword=<smtp-password>
Email__FromAddress=<verified-sender-address>
Email__FromName=MPS

# Use the exact public origins for the deployed frontend.
Cors__AllowedOrigins__0=https://<your-domain>
